# ── Anthropic ────────────────────────────────────────────────
# Server-only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# "anthropic" for real generation, "mock" for canned output (no key, no cost; used by tests)
LLM_PROVIDER=mock
# Model used for all live, in-app generation
MODEL_RUNTIME=claude-haiku-5-5
# Model used by the one-time offline content scripts (summaries, characters, adventure maps)
MODEL_OFFLINE=claude-haiku-5-5

# ── Server storage (libSQL) ──────────────────────────────────
# Local: a SQLite file. Production (Vercel): a Turso URL, e.g. libsql://multibooks-<org>.turso.io
DATABASE_URL=file:./data/local.db
# Turso auth token (leave empty for local file)
DATABASE_AUTH_TOKEN=

# ── Cost controls ────────────────────────────────────────────
# Live generation stops (gracefully) once estimated spend for the UTC day reaches this
DAILY_BUDGET_USD=5
# Max live generations per anonymous session per day
PER_SESSION_MAX_GENERATIONS=40
# Create Your Own: offer "Ready to write the ending?" at this turn; force an ending at the hard cap
CYO_SOFT_TURN_CAP=20
CYO_HARD_TURN_CAP=25
# New generations per minute (cache hits are never limited). Per session is tight; per IP is
# generous because a whole classroom usually shares one public IP address.
RATE_LIMIT_SESSION_PER_MINUTE=8
RATE_LIMIT_IP_PER_MINUTE=150

# ── Admin & research ─────────────────────────────────────────
# Password for /admin/stats
ADMIN_PASSWORD=change-me
# Secret used to sign the admin cookie and salt IP hashes (any long random string)
APP_SECRET=replace-with-a-long-random-string
# Survey link opened by "Give feedback"
NEXT_PUBLIC_FEEDBACK_URL=https://forms.gle/your-survey
