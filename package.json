{
  "name": "multibooks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:fetch": "tsx --env-file-if-exists=.env.local scripts/fetch-gutenberg.ts",
    "content:chunk": "tsx --env-file-if-exists=.env.local scripts/clean-and-chunk.ts",
    "content:summaries": "tsx --env-file-if-exists=.env.local scripts/gen-summaries.ts",
    "content:maps": "tsx --env-file-if-exists=.env.local scripts/gen-adventure-map.ts",
    "content:validate": "tsx --env-file-if-exists=.env.local scripts/validate-content.ts",
    "cache:prewarm": "tsx --env-file-if-exists=.env.local scripts/prewarm-detours.ts",
    "cache:export-review": "tsx --env-file-if-exists=.env.local scripts/export-review.ts",
    "cache:apply-review": "tsx --env-file-if-exists=.env.local scripts/apply-review.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@libsql/client": "^0.18.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
